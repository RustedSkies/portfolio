---
import background from '../assets/background.svg';
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<nav class="navbar">
			<div class="nav-left">
				<p>Marcus Knight</p>
			</div>
			<div class="nav-middle">
				<a href="#hero">PROFILE</a>
				<a href="#experience">EXPERIENCE</a>
				<a href="#projects">PROJECTS</a>
			</div>
			<div class="nav-right">
				<a href="#">Resume</a>
			</div>
		</nav>

		<section id="hero">
			<h1>Marcus Knight</h1>
			<h2>ECE Student, CS Minor</h2>

			<p>Description about myself... Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent arcu sem, tincidunt eu molestie vel, rhoncus quis nisl. Pellentesque sed placerat lacus.</p>

			<div id="links">
				<a href="#">GitHub</a>
				<a href="#">LinkedIn</a>
				<a href="#">Resume</a>
			</div>
		</section>

		<section id="projects">
			<h1>Projects</h1>
			<p>Game engine, block stacking</p>
		</section>

		<section id="experience">
			<h1>Experience</h1>
			<p>cornerstone</p>
		</section>

		<section id="skills">
			<h1>Skills</h1>
			<p>group by system level: low-level, hardware, software</p>
		</section>

		<section id="contact">
			<h1>Contact</h1>
			<p>email, github, linkedin, resume</p>
		</section>

		<ul>
			<li>Hero Section</li>
			<li>Game Engine Showcase</li>
			<li>Block stacking game showcase</li>
			<li>Real-world experience</li>
			<li>Skills and tech stack</li>
			<li>Contact</li>
			<li>footer</li>
		</ul>

		<p>Use monospace style, dark mode, terminal-esque. Circuit traces, perhaps with moving dots to look like current</p>
		<p>grid background</p>
	</main>
</div>

<style>
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	#container {
		font-family:
			'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		height: 100%;
	}

	main {
		height: 100%;
	}

	.navbar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 1rem 2rem;
		background-color: #1a1a1a;
	}

	.nav-left {
		justify-self: start;
	}

	.nav-middle {
		justify-self: center;
		display: flex;
		gap: 2rem;
	}

	.nav-right {
		justify-self: end;
	}

	.navbar a, .navbar p {
		text-decoration: none;
		font-size: 0.95rem;
		transition: color 0.2s ease;
		color: #cecece;
	}

	.navbar a:hover {
		text-decoration: underline;
		color: #fff;
	}

	section {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
		margin-top: 0;
	}

	#hero {
		margin-top: 4rem;
		margin-bottom: 2rem;
	}

	#hero h1 {
		font-size: 38px;
		margin-bottom: 0;
	}

	#hero h2 {
		font-size: 22px;
	}

	h1 {
		font-size: 22px;
		margin-top: 0.25em;
	}

	#links {
		display: flex;
		gap: 16px;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	code {
		display: inline-block;
		background:
			linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
			linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
		border-radius: 8px;
		border: 1px solid transparent;
		padding: 6px 8px;
	}
</style>
