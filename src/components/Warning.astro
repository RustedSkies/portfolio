---
---

<div id="warning">
	<div id="popup">
		<h2>Warning</h2>
		<p>This site is under construction!</p>
	</div>
</div>

<style>
	@keyframes hide {
		0% {
			transform: none;
		}
		60% {
			transform: none;
		}
		100% {
			transform: translateY(-120%);
		}
	}

	#warning {
		position: absolute;
		justify-content: center;
		display: flex;
		width: 100%;

		animation-name: hide;
		animation-duration: 3s;
		animation-fill-mode: forwards;
		animation-play-state: running;
	}

	#popup {
		background-color: #ffeb4099;
		border: 2px #000 solid;
		border-radius: 1rem;
		padding: 0rem 2rem;
		margin: 1rem;
		color: #000;
	}

	#popup h2 {
		text-align: center;
		margin-bottom: -0.75rem;
	}

	p {
		margin-bottom: 0.5rem;
	}
</style>
